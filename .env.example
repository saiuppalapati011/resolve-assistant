# Copy this to .env and fill in your values

# --- Required for Anthropic provider ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Required for Gemini provider ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- LLM Provider selection (overrides config.yaml) ---
# Options: "anthropic" | "gemini" | "ollama"
LLM_PROVIDER=anthropic

# --- Model selection (overrides config.yaml default) ---
# For Anthropic: e.g. claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5
# For Gemini: e.g. gemini-2.5-flash, gemini-2.5-pro
# For Ollama: e.g. llama3.1, mistral, codellama
LLM_MODEL=claude-sonnet-4-5

# --- Ollama settings (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434

# --- Optional web fallback for unanswered documentation questions ---
# Local Resolve documentation is always searched first.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_TIMEOUT=8
WEB_SEARCH_MAX_RESULTS=5
